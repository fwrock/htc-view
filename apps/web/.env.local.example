# URL base da API do simulador HTC
# Altere para o host/porta onde o hyperbolic-time-chamber está a correr
NEXT_PUBLIC_HTC_API_URL=http://localhost:9804/api/v1

# SimEDaPE job API, including native full HTC execution
NEXT_PUBLIC_SIMEDAPE_API_URL=http://localhost:5000

# Server-to-server connection used to prepare native run replay (may differ from browser URL)
SIMEDAPE_API_URL=http://127.0.0.1:5000

# WebSocket da visualização ao vivo (htc-bus-live's LiveApp, GET /ws/live)
# Altere para o host/porta onde o htc-bus-live está a correr
NEXT_PUBLIC_HTC_LIVE_WS_URL=ws://localhost:8090/ws/live

# Visual background, shared by live and replay: none (default) or osm.
# This switch does not make a synthetic HTC network compatible with OSM roads.
NEXT_PUBLIC_HTC_MAP_BACKGROUND=none
# With MAP_BACKGROUND=osm, optionally set a style URL or tile URL and required attribution.
# NEXT_PUBLIC_HTC_MAP_STYLE_URL=https://your-provider.example/style.json
# NEXT_PUBLIC_HTC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_HTC_MAP_ATTRIBUTION=<a href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors</a>

# ── Ponte de replay (server-side, lida pelo Next.js em /api/replay) ──────────────
# Caminhos no filesystem do host do engine (o browser não os alcança; o servidor Next
# faz a ponte em dev local). Os defaults já funcionam nesta máquina — veja lib/replay-config.ts.
# HTC_SCENARIOS_DIR=/home/dean/hyperbolic-time-chamber/simulations/input
# HTC_REPORT_PARQUET_DIRECTORY=/home/dean/hyperbolic-time-chamber/output/reports/parquet
# HTC_REPLAY_OUT_DIR=/home/dean/hyperbolic-time-chamber/output/replay
# HTC_REPLAY_ETL_DIR=/home/dean/workspace/phd/htc-platform/htc-replay/etl

# ── Métricas Prometheus (lida por /api/metrics) ──────────────────────────────────
# O engine sobe as métricas na 9002 (a 9001 é ocupada pelo console do ainvai-local-minio).
# Este é o default do app/api/metrics/route.ts; ajuste se usar outra porta.
# HTC_METRICS_URL=http://localhost:9002/metrics

# ── Logs viewer (server-side, lida pelo Next.js em /api/logs) ─────────────────────
# Caminhos dos logs da stack escritos pelo scripts/run-live-demo.sh. Os defaults já
# batem com a saída /tmp do script.
# HTC_ENGINE_LOG=/tmp/htc-engine.log
# HTC_BUS_LIVE_LOG=/tmp/htc-bus-live.log
# HTC_UI_LOG=/tmp/htc-ui-dev.log
# Shared container/native stack logs (engine.log, bus-live.log, simedape.log, view.log).
# HTC_LOGS_DIR=/tmp/htc-platform-native
# Startup profiles are saved by the SimEDaPE API. Configure HTC_ENGINE_PROFILE_FILE there,
# and start HTC with -Dconfig.file pointing at the same generated file.
