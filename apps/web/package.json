{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test:replay": "node --experimental-strip-types --test tests/native-replay.test.mjs tests/road-geometry.test.mjs tests/entity-rendering.test.mjs tests/sidewalks.test.mjs tests/live-transit.test.mjs",
    "test:i18n": "node --experimental-strip-types --test tests/i18n.test.mjs",
    "test:live": "node --experimental-strip-types --test tests/live-scenarios.test.mjs",
    "test:reports": "node --experimental-strip-types --test tests/report-export.test.mjs && python3 tests/test_report_renderer.py",
    "test:simedape": "node --experimental-strip-types --test tests/simedape-backends.test.mjs",
    "test:timings": "node --experimental-strip-types --test tests/execution-timings.test.mjs"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.1.0",
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/react": "^9.1.0",
    "@workspace/ui": "*",
    "apache-arrow": "^18.1.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "maplibre-gl": "^4.7.1",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-map-gl": "^7.1.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  }
}
